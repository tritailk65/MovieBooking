ASPNETCORE_ENVIRONMENT=Production
COMPOSE_PROJECT_NAME=moviebooking-production
PUBLIC_HOST=api.moviebooking.example
API_BASE_URL=https://api.moviebooking.example

CONTAINER_REGISTRY=ghcr.io/your-organization
IMAGE_TAG=replace-with-git-sha

TLS_CERT_PATH=./deploy/tls/production/tls.crt
TLS_KEY_PATH=./deploy/tls/production/tls.key

EDGE_NETWORK_SUBNET=10.32.0.0/24
BACKEND_NETWORK_SUBNET=10.33.0.0/24

POSTGRES_USER=moviebooking_production
POSTGRES_PASSWORD=replace-with-secret
REDIS_PASSWORD=replace-with-secret
RABBITMQ_USER=moviebooking_production
RABBITMQ_PASSWORD=replace-with-secret
# URL-encoded form of RABBITMQ_PASSWORD, used only inside AMQP connection URIs.
RABBITMQ_PASSWORD_URI=replace-with-url-encoded-secret

# Keep the simulator only until a real payment provider replaces Payment.API's stub.
PAYMENT_SIMULATOR_SUCCEEDS=true
