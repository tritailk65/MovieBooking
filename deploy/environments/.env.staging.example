ASPNETCORE_ENVIRONMENT=Staging
COMPOSE_PROJECT_NAME=moviebooking-staging
PUBLIC_HOST=api-staging.moviebooking.example
API_BASE_URL=https://api-staging.moviebooking.example

CONTAINER_REGISTRY=ghcr.io/your-organization
IMAGE_TAG=replace-with-git-sha

TLS_CERT_PATH=./deploy/tls/staging/tls.crt
TLS_KEY_PATH=./deploy/tls/staging/tls.key

EDGE_NETWORK_SUBNET=10.30.0.0/24
BACKEND_NETWORK_SUBNET=10.31.0.0/24

POSTGRES_USER=moviebooking_staging
POSTGRES_PASSWORD=replace-with-secret
REDIS_PASSWORD=replace-with-secret
RABBITMQ_USER=moviebooking_staging
RABBITMQ_PASSWORD=replace-with-secret
# URL-encoded form of RABBITMQ_PASSWORD, used only inside AMQP connection URIs.
RABBITMQ_PASSWORD_URI=replace-with-url-encoded-secret

PAYMENT_SIMULATOR_SUCCEEDS=true
