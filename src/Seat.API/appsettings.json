{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "Seat.API V1"
    },
    "Document": {
      "Description": "The Seat Microservice HTTP API.",
      "Title": "Movie Booking - Seat HTTP API",
      "Version": "v1"
    }
  },
  "Kestrel": {
    "EndpointDefaults": {
      // "Protocols": "Http2"
      "Protocols": "Http1AndHttp2"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost",
    "EventBus": "amqp://localhost"
  },
  "EventBus": {
    "SubscriptionClientName": "Seat"
  },
  "Identity": {
    "Url": "http://localhost:8080",
    "ClientId": "movie-booking-client",
    "Audience": "seat",
    "Scopes": {
      "seat.read": "Read access to Seat API",
      "seat.write": "Write access to Seat API",
      "openid": "OpenID authentication",
      "profile": "User profile"
    }
  }
}
