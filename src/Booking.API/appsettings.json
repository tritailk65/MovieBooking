{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Endpoint": {
      "Name": "Booking.API V1"
    },
    "Document": {
      "Description": "The Booking Microservice HTTP API.",
      "Title": "Movie Booking - Booking HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost",
    "EventBus": "amqp://localhost"
  },
  "Grpc": {
    "SeatUrl": "https://localhost:7247"
  },
  "EventBus": {
    "SubscriptionClientName": "Booking"
  },
  "Identity": {
    "Url": "http://localhost:8080",
    "ClientId": "movie-booking-client",
    "Audience": "booking",
    "Scopes": {
      "booking.read": "Read access to Booking API",
      "booking.write": "Write access to Booking API",
      "openid": "OpenID authentication",
      "profile": "User profile"
    }
  }

}
