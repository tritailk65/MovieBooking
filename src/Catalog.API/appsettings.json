{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "Endpoint": {
      "Name": "Catalog.API V1"
    },
    "Document": {
      "Description": "The Catalog Microservice HTTP API.",
      "Title": "Movie Booking - Catalog HTTP API",
      "Version": "v1"
    }
  },
  "ConnectionStrings": {
    "EventBus": "amqp://localhost"
  },
  "EventBus": {
    "SubscriptionClientName": "Catalog"
  },
  "CatalogOptions": {
    "UseCustomizationData": false
  }
  ,
  "Identity": {
    "Url": "http://localhost:8080",
    "ClientId": "movie-booking-client",
    "Audience": "catalog",
    "Scopes": {
      "catalog.read": "Read access to Catalog API",
      "catalog.write": "Write access to Catalog API",
      "openid": "OpenID authentication",
      "profile": "User profile"
    }
  }
}
